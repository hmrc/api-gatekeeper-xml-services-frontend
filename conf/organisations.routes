# microservice specific routes

#Organisation Routes
GET         /                                                   uk.gov.hmrc.apigatekeeperxmlservicesfrontend.controllers.OrganisationController.organisationsPage
GET         /search                                             uk.gov.hmrc.apigatekeeperxmlservicesfrontend.controllers.OrganisationController.organisationsSearchAction(searchType: String, searchText: Option[String])

GET         /add                                                uk.gov.hmrc.apigatekeeperxmlservicesfrontend.controllers.OrganisationController.organisationsAddPage
POST        /add                                                uk.gov.hmrc.apigatekeeperxmlservicesfrontend.controllers.OrganisationController.organisationsAddAction()

POST        /add/new-user                                       uk.gov.hmrc.apigatekeeperxmlservicesfrontend.controllers.OrganisationController.organisationsAddWithNewUserAction()

GET         /:organisationId                                    uk.gov.hmrc.apigatekeeperxmlservicesfrontend.controllers.OrganisationController.viewOrganisationPage(organisationId: SimpleOrganisationId)

GET         /:organisationId/update                             uk.gov.hmrc.apigatekeeperxmlservicesfrontend.controllers.OrganisationController.updateOrganisationsDetailsPage(organisationId: SimpleOrganisationId)
POST        /:organisationId/update                             uk.gov.hmrc.apigatekeeperxmlservicesfrontend.controllers.OrganisationController.updateOrganisationsDetailsAction(organisationId: SimpleOrganisationId)

GET         /:organisationId/remove                             uk.gov.hmrc.apigatekeeperxmlservicesfrontend.controllers.OrganisationController.removeOrganisationPage(organisationId: SimpleOrganisationId)
POST        /:organisationId/remove                             uk.gov.hmrc.apigatekeeperxmlservicesfrontend.controllers.OrganisationController.removeOrganisationAction(organisationId: SimpleOrganisationId)

#Team member routes
GET         /:organisationId/team-members                       uk.gov.hmrc.apigatekeeperxmlservicesfrontend.controllers.TeamMembersController.manageTeamMembers(organisationId: SimpleOrganisationId)

GET         /:organisationId/team-members/add                   uk.gov.hmrc.apigatekeeperxmlservicesfrontend.controllers.TeamMembersController.addTeamMemberPage(organisationId: SimpleOrganisationId)
POST        /:organisationId/team-members/add                   uk.gov.hmrc.apigatekeeperxmlservicesfrontend.controllers.TeamMembersController.addTeamMemberAction(organisationId: SimpleOrganisationId)

POST        /:organisationId/team-members/create                uk.gov.hmrc.apigatekeeperxmlservicesfrontend.controllers.TeamMembersController.createTeamMemberAction(organisationId: SimpleOrganisationId)


GET         /:organisationId/team-members/:userId/remove        uk.gov.hmrc.apigatekeeperxmlservicesfrontend.controllers.TeamMembersController.removeTeamMember(organisationId: SimpleOrganisationId, userId: String)
POST        /:organisationId/team-members/:userId/remove        uk.gov.hmrc.apigatekeeperxmlservicesfrontend.controllers.TeamMembersController.removeTeamMemberAction(organisationId: SimpleOrganisationId, userId: String)
